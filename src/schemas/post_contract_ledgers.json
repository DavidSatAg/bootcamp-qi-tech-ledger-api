{
  "title": "PostContractLedgers",
  "type": "object",
  "properties": {
    "contract_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "client_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "client_party_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "split_version": {
      "type": "integer",
      "minimum": 1
    },
    "rent_amount_in_cents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "platform_fee_percentage": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4})?$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "purpose_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "beneficiary_party_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "beneficiary_role": {
            "enum": [
              "landlord",
              "administrator",
              "provider"
            ]
          },
          "type": {
            "enum": [
              "percentage",
              "fixed",
              "remainder"
            ]
          },
          "value": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "required": [
          "purpose_code",
          "beneficiary_party_key",
          "beneficiary_role",
          "type"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "percentage"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4})?$"
                }
              },
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fixed"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000000000
                }
              },
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remainder"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "value"
                ]
              },
              "properties": {
                "beneficiary_role": {
                  "const": "landlord"
                }
              }
            }
          }
        ]
      },
      "contains": {
        "properties": {
          "type": {
            "const": "remainder"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "reason": {
      "type": "string",
      "maxLength": 255
    }
  },
  "required": [
    "contract_key",
    "client_key",
    "client_party_key",
    "split_version",
    "rent_amount_in_cents",
    "platform_fee_percentage",
    "items",
    "actor"
  ],
  "additionalProperties": false
}
