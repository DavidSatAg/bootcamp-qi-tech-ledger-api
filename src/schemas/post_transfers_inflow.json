{
  "title": "PostTransfersInflow",
  "type": "object",
  "properties": {
    "amount_in_cents": {
      "type": "integer",
      "minimum": 1
    },
    "contract_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "payer_party_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "period_reference": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "end_to_end_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "value_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "reason": {
      "type": "string",
      "maxLength": 255
    }
