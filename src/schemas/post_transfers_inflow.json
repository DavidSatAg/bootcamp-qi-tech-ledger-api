{
  "title": "PostTransfersInflow",
  "type": "object",
  "properties": {
    "amount_in_cents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "client_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "contract_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "payer_party_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "period_reference": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "end_to_end_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "value_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "reason": {
      "type": "string",
      "maxLength": 255
    },
    "source_wallet_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "wallet_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "amount_in_cents",
    "actor"
  ],
  "oneOf": [
    {
      "required": [
        "contract_key",
        "period_reference",
        "payer_party_key",
        "end_to_end_id"
      ],
      "not": {
        "anyOf": [
          {"required": ["source_wallet_key"]},
          {"required": ["wallet_key"]},
          {"required": ["client_key"]}
        ]
      }
    },
    {
      "required": [
        "contract_key",
        "period_reference",
        "source_wallet_key"
      ],
      "not": {
        "anyOf": [
          {"required": ["payer_party_key"]},
          {"required": ["end_to_end_id"]},
          {"required": ["wallet_key"]},
          {"required": ["client_key"]}
        ]
      }
    },
    {
      "required": [
        "wallet_key",
        "end_to_end_id"
      ],
      "not": {
        "anyOf": [
          {"required": ["contract_key"]},
          {"required": ["period_reference"]},
          {"required": ["payer_party_key"]},
          {"required": ["source_wallet_key"]},
          {"required": ["client_key"]}
        ]
      }
    },
    {
      "required": [
        "client_key",
        "end_to_end_id"
      ],
      "not": {
        "anyOf": [
          {"required": ["contract_key"]},
          {"required": ["period_reference"]},
          {"required": ["payer_party_key"]},
          {"required": ["source_wallet_key"]},
          {"required": ["wallet_key"]}
        ]
      }
    }
  ],
  "additionalProperties": false
}
