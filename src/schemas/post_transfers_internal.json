{
  "title": "PostTransfersInternal",
  "type": "object",
  "properties": {
    "source_account_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "gross_amount_in_cents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "target_account_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "type": {
            "enum": [
              "percentage",
              "fixed",
              "remainder"
            ]
          },
          "value": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "required": [
          "target_account_key",
          "type"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "percentage"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4})?$"
                }
              },
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fixed"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000000000
                }
              },
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remainder"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          }
        ]
      },
      "contains": {
        "properties": {
          "type": {
            "const": "remainder"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 0,
      "maxContains": 1
    },
    "value_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    }
  },
  "required": [
    "source_account_key",
    "gross_amount_in_cents",
    "allocations",
    "actor",
    "reason"
  ],
  "additionalProperties": false
}
